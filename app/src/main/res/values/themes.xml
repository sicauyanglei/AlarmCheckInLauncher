<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlarmCheckInLauncher" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#1976D2</item>
        <item name="colorPrimaryVariant">#1565C0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF6F00</item>
        <item name="colorOnSecondary">#FFFFFF</item>
    </style>

    <!-- 全屏主题：用于 LaunchProxyActivity，覆盖闹钟全屏界面，拉起目标 App 后立即消失 -->
    <style name="Theme.LaunchProxy" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
