<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_github_token"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_github_token"
            android:inputType="textPassword"
            android:maxLines="1"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_github_owner"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_github_owner"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_github_repo"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_github_repo"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_github_branch"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_github_branch"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_github_path"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_github_path"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnFillCurrentRepo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_fill_current_repo" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save_github" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:textColor="#888888"
            android:text="@string/tip_github_token" />

    </LinearLayout>
</ScrollView>
